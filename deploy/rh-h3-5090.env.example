INSTALL_ROOT=/data/sglang-h3
MODEL_PATH=/data/sglang-h3/models/MiniMax-H3
QUANT_ROOT=/data/sglang-h3/models/minimax-h3-comfy
CUDA_HOME=/usr/local/cuda-13.0
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
HOST=0.0.0.0
PORT=30010

# balanced | low-host-memory | low-gpu-memory | fastest-risky
PLACEMENT_PROFILE=balanced

# Default deployment is TP1 + Ulysses8 on eight GPUs.
NUM_GPUS=8
TP_SIZE=1
ULYSSES_DEGREE=8

# Full 20-step denoising; no Cache-DiT approximation and no LoRA.
SGLANG_CACHE_DIT_ENABLED=false
WARMUP_RESOLUTIONS=1344x768
WARMUP_NUM_FRAMES=362
WARMUP_STEPS=20
